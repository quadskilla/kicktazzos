NODE_ENV=production
HOST=0.0.0.0
DATA_DIR=/data

# Local fallback only. Railway injects PORT automatically.
# PORT=8025

# Optional: Firebase Authentication
# Frontend public config from Firebase project settings.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_AUTH_PROVIDERS=google,facebook

# Server-side token verification.
# Paste the service account JSON as one line, or base64-encode it.
# FIREBASE_SERVICE_ACCOUNT=

NODE_ENV=production
HOST=0.0.0.0
DATA_DIR=/data

# Local fallback only. Railway injects PORT automatically.
# PORT=8025

# Optional: Firebase Authentication
# Kick Tazzos already ships with the public Tazzostrike Firebase web config.
# Use these only if you need to override it locally or in another deploy.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_AUTH_PROVIDERS=google

# Admin dashboard at /admin.
# quadskilla@gmail.com is allowed by default when logged in with verified Google.
# Add more emails separated by comma if needed.
# ADMIN_EMAILS=quadskilla@gmail.com
# Required in production for stable signed player/admin sessions. Generate a long random value.
SESSION_SECRET=
# Optional separate signing secret for player sessions.
# PLAYER_SESSION_SECRET=
# Temporary migration switch for old unsigned player cookies. Keep false unless you are doing a short rollout migration.
ALLOW_LEGACY_PLAYER_COOKIES=false
# Optional emergency token login for /admin.
# ADMIN_TOKEN=
# Optional separate signing secret for admin token sessions.
# ADMIN_SESSION_SECRET=

# Basic API abuse protection.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=240
# RATE_LIMIT_SENSITIVE_MAX=40

# MerreisCoin sandbox/testnet. Keep disabled until the testnet contract is deployed.
# Local secrets can live in .env.crypto.local, which is ignored by git.
# Default target is Base Sepolia:
# chain id 84532, RPC https://sepolia.base.org, explorer https://sepolia.basescan.org
MERREISCOIN_TESTNET_ENABLED=false
MERREISCOIN_NETWORK=base-sepolia
MERREISCOIN_CHAIN_ID=84532
MERREISCOIN_RPC_URL=https://sepolia.base.org
MERREISCOIN_EXPLORER_URL=https://sepolia.basescan.org
MERREISCOIN_CONTRACT_ADDRESS=
MERREISCOIN_DECIMALS=0
MERREISCOIN_MAX_SUPPLY=1000000000
# Scripts only. Never commit a real private key.
MERREISCOIN_DEPLOYER_PRIVATE_KEY=
MERREISCOIN_OWNER_ADDRESS=
MERREISCOIN_MINT_TO=
MERREISCOIN_MINT_AMOUNT=
MERREISCOIN_MINT_REASON=

# Mercado Pago Checkout Pro for real Merreis purchases.
# Use an access token from Mercado Pago Developers > Credenciais.
# PUBLIC_BASE_URL is recommended; if empty, production can infer the current HTTPS host.
# Configure the webhook event "payments" to POST to:
# https://your-domain.example/api/mercadopago/webhook
MERCADO_PAGO_ACCESS_TOKEN=
PUBLIC_BASE_URL=
# Required in production: validate Mercado Pago webhook x-signature.
MERCADO_PAGO_WEBHOOK_SECRET=
